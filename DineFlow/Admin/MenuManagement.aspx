<%@ Page Title="Menu Management | DineFlow Admin" Language="C#" MasterPageFile="~/Admin/MasterPages/Admin.master" AutoEventWireup="true" CodeFile="MenuManagement.aspx.cs" Inherits="DineFlow.Admin.MenuManagement" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <link rel="stylesheet" href="CSS/menu-management.css" />
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">
    <div class="menu-page">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-end gap-3 mb-4">
            <div><span class="eyebrow">Catalog control center</span><h1 class="page-title mb-2">Menu management</h1><p class="text-muted mb-0">Manage menu items and categories from the database.</p></div>
            <div class="menu-header-actions">
                <button type="button" class="btn btn-outline-dark add-category-btn" onclick="openCategoryEditor()">Add category</button>
                <asp:Button ID="btnAddItem" runat="server" Text="Add menu item" CssClass="btn btn-dark add-item-btn" OnClick="btnAddItem_Click" />
            </div>
        </div>
        <asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="alert mb-4" role="alert"><asp:Literal ID="litMessage" runat="server" /></asp:Panel>
        <section class="catalog-card">
            <div class="catalog-toolbar"><div><h2 class="section-title mb-1">Your menu</h2><p class="text-muted mb-0">Items loaded from the database</p></div></div>
            <div class="category-tabs" role="tablist"><span class="category-tab active">Categories</span><asp:Repeater ID="rptCategoryTabs" runat="server"><ItemTemplate><span class="category-tab"><%# Eval("CategoryName") %></span></ItemTemplate></asp:Repeater></div>
            <div class="table-responsive"><asp:GridView ID="gvMenuItems" runat="server" AutoGenerateColumns="false" CssClass="table menu-table align-middle mb-0" GridLines="None" EmptyDataText="No menu items found." DataKeyNames="MenuItemId" OnRowCommand="gvMenuItems_RowCommand"><Columns>
                <asp:TemplateField HeaderText="Photo"><ItemTemplate><asp:Image ID="imgProduct" runat="server" CssClass="product-thumbnail" ImageUrl='<%# ResolveUrl("~/Admin/" + Eval("ImagePath")) %>' AlternateText='<%# Eval("ItemName") %>' /></ItemTemplate></asp:TemplateField><asp:BoundField DataField="ItemName" HeaderText="Menu item" /><asp:BoundField DataField="Description" HeaderText="Description" /><asp:BoundField DataField="CategoryName" HeaderText="Category" /><asp:BoundField DataField="Price" HeaderText="Price" DataFormatString="Rs.{0:N2}" /><asp:BoundField DataField="IsAvailable" HeaderText="Available" />
                <asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton ID="btnEdit" runat="server" CommandName="editItem" CommandArgument='<%# ((GridViewRow)Container).RowIndex %>' CssClass="icon-action" ToolTip="Edit item"><i class="fa-solid fa-pen"></i></asp:LinkButton><asp:LinkButton ID="btnDelete" runat="server" CommandName="deleteItem" CommandArgument='<%# ((GridViewRow)Container).RowIndex %>' CssClass="icon-action delete-item" ToolTip="Delete item" OnClientClick="return confirm('Delete this menu item?');"><i class="fa-regular fa-trash-can"></i></asp:LinkButton></ItemTemplate></asp:TemplateField>
            </Columns></asp:GridView></div>
        </section>
    </div>
    <asp:Panel ID="pnlItemEditor" runat="server" CssClass="modal fade show" Style="display:none;" ClientIDMode="Static"><div class="modal-dialog modal-dialog-centered"><div class="modal-content menu-modal-content"><div class="modal-header"><div><span class="eyebrow">Catalog editor</span><h2 class="modal-title"><asp:Literal ID="litEditorTitle" runat="server" Text="Add menu item" /></h2></div><asp:LinkButton ID="btnCloseEditor" runat="server" CssClass="btn-close" OnClick="btnCloseEditor_Click" /></div><div class="modal-body"><asp:HiddenField ID="hidMenuItemId" runat="server" /><asp:HiddenField ID="hidImagePath" runat="server" /><asp:ValidationSummary ID="valSummary" runat="server" CssClass="alert alert-danger" /><div class="row g-3"><div class="col-md-8"><label class="form-label">Dish name</label><asp:TextBox ID="txtItemName" runat="server" CssClass="form-control" /></div><div class="col-md-4"><label class="form-label">Price</label><asp:TextBox ID="txtPrice" runat="server" CssClass="form-control" TextMode="Number" /></div><div class="col-12"><label class="form-label">Category</label><div class="d-flex gap-2"><asp:DropDownList ID="ddlCategory" runat="server" CssClass="form-select" /><asp:TextBox ID="txtNewCategory" runat="server" CssClass="form-control" placeholder="New category" /><asp:Button ID="btnAddCategory" runat="server" Text="+" CssClass="btn btn-outline-secondary" ToolTip="Add category" OnClick="btnAddCategory_Click" /></div></div><div class="col-md-6"><label class="form-label">Availability</label><asp:DropDownList ID="ddlAvailability" runat="server" CssClass="form-select"><asp:ListItem Text="Available" Value="true" /><asp:ListItem Text="Sold out" Value="false" /></asp:DropDownList></div><div class="col-12"><label class="form-label">Description</label><asp:TextBox ID="txtDescription" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" /></div><div class="col-12"><label class="form-label">Product photo <small class="text-muted">(required for new items; leave empty while editing to keep the current photo)</small></label><asp:FileUpload ID="prodimg" runat="server" CssClass="form-control" accept="image/*" /></div></div></div><div class="modal-footer"><asp:Button ID="btnCancelEditor" runat="server" Text="Cancel" CssClass="btn btn-light" OnClick="btnCancelEditor_Click" /><asp:Button ID="btnSaveItem" runat="server" Text="Save item" CssClass="btn btn-dark" OnClick="addprod_Click" /></div></div></div></asp:Panel>
</asp:Content>
<asp:Content ID="Content3" ContentPlaceHolderID="scripts" runat="server"><script src="JS/menu-management.js"></script></asp:Content>
