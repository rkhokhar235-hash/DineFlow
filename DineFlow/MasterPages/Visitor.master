<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Visitor.master.cs" Inherits="DineFlow.MasterPages.Visitor" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>DineFlow - Scan. Order. Enjoy.</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet" />

    <!-- Third-Party CSS Libraries -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" integrity="sha512-1cK78a1o+ht2JcaW6gMAGL5XlFkgxLJKBWuhtPq3SkcDsFXTNZXw8JHye1P+ADuHY05RHscgS2es6Y05puqY8g==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Global Master Stylesheet -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/Assets/CSS/master.css") %>" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class='<%= Request.Url.AbsolutePath.EndsWith("About.aspx", StringComparison.OrdinalIgnoreCase) ? "about-page" : "" %>'>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />

        <!-- Scroll Progress Bar -->
        <div id="scrollProgress" class="scroll-progress-bar" aria-hidden="true"></div>

        <!-- Fullscreen Loader -->
        <div id="dfLoader" class="df-loader">
            <div class="loader-content">
                <div class="loader-logo-wrap">
                    <span class="logo-mark">DF</span>
                    <h1 class="logo-text">DineFlow</h1>
                </div>
                <div class="loader-counter">
                    <span id="loaderPercent">0</span>%
                </div>
                <div class="loader-bar-bg">
                    <div id="loaderBar" class="loader-bar-fill"></div>
                </div>
                <p class="loader-tagline">Scan . Order . Enjoy</p>
            </div>
        </div>

        <% if (!IsOrderPage) { %>
        <!-- Sticky Glass Navigation Header -->
        <header id="dfHeader" class='df-header <%= Request.Url.AbsolutePath.EndsWith("About.aspx", StringComparison.OrdinalIgnoreCase) ? "about-transparent" : "" %>'>
            <nav class="navbar navbar-expand-lg">
                <div class="container-fluid container-xl">
                    <a class="navbar-brand df-brand" href='<%= ResolveUrl("~/Visitor/Home.aspx") %>'>
                        <span class="brand-crest"><i class="fa-solid fa-utensils"></i></span>
                        <span class="brand-text">Dine<span>Flow</span></span>
                    </a>

                    <div class="d-flex align-items-center d-lg-none gap-2">
                        <button type="button" class="btn-icon-search me-1" id="btnSearchMobile" aria-label="Open Search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                        <button class="navbar-toggler df-hamburger" type="button" id="btnMobileNavToggle" aria-label="Toggle Navigation">
                            <span class="hamburger-box">
                                <span class="hamburger-inner"></span>
                            </span>
                        </button>
                    </div>

                    <div class="collapse navbar-collapse df-nav-collapse" id="dfNavMenu">
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 df-nav-list">
                            <li class="nav-item">
                                <a class="nav-link df-link" href='<%= ResolveUrl("~/Visitor/Home.aspx") %>'>Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link df-link" href='<%= ResolveUrl("~/Visitor/About.aspx") %>'>About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link df-link" href='<%= ResolveUrl("~/Visitor/OurMenu.aspx") %>'>Our Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link df-link" href='<%= ResolveUrl("~/Visitor/Gallery.aspx") %>'>Gallery</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link df-link" href='<%= ResolveUrl("~/Visitor/Branches.aspx") %>'>Branches</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link df-link" href='<%= ResolveUrl("~/Visitor/Blog.aspx") %>'>Blog</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link df-link" href='<%= ResolveUrl("~/Visitor/Contact.aspx") %>'>Contact</a>
                            </li>
                        </ul>

                        <div class="df-nav-actions d-none d-lg-flex align-items-center gap-3">
                            <button type="button" class="btn-icon-search" id="btnSearchDesktop" aria-label="Search Dishes">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                            <a href='<%= ResolveUrl("~/Visitor/Reservation.aspx") %>' class="btn-df-gold">
                                <span>Reserve Table</span>
                                <i class="fa-solid fa-arrow-right-long ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Mobile Navigation Drawer -->
        <div id="dfMobileDrawer" class="df-mobile-drawer" aria-hidden="true">
            <div class="drawer-header d-flex justify-content-between align-items-center">
                <a class="df-brand" href='<%= ResolveUrl("~/Visitor/Home.aspx") %>'>
                    <span class="brand-text">Dine<span>Flow</span></span>
                </a>
                <button type="button" class="btn-close-drawer" id="btnCloseDrawer" aria-label="Close Drawer">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="drawer-body">
                <ul class="mobile-nav-list">
                    <li><a href='<%= ResolveUrl("~/Visitor/Home.aspx") %>'>Home</a></li>
                    <li><a href='<%= ResolveUrl("~/Visitor/About.aspx") %>'>About</a></li>
                    <li><a href='<%= ResolveUrl("~/Visitor/OurMenu.aspx") %>'>Our Menu</a></li>
                    <li><a href='<%= ResolveUrl("~/Visitor/Gallery.aspx") %>'>Gallery</a></li>
                    <li><a href='<%= ResolveUrl("~/Visitor/Branches.aspx") %>'>Branches</a></li>
                    <li><a href='<%= ResolveUrl("~/Visitor/Blog.aspx") %>'>Blog</a></li>
                    <li><a href='<%= ResolveUrl("~/Visitor/Contact.aspx") %>'>Contact</a></li>
                </ul>
                <div class="drawer-footer mt-auto pt-4">
                    <a href='<%= ResolveUrl("~/Visitor/Reservation.aspx") %>' class="btn-df-gold w-100 text-center">
                        <span>Reserve Table</span>
                    </a>
                    <div class="drawer-contact mt-4">
                        <p><i class="fa-solid fa-phone me-2"></i> +1 (800) 555-DINE</p>
                        <p><i class="fa-solid fa-envelope me-2"></i> concierge@dineflow.com</p>
                    </div>
                </div>
            </div>
        </div>
        <div id="drawerBackdrop" class="drawer-backdrop"></div>
        <% } %>

        <!-- Fullscreen Search Modal -->
        <div id="dfSearchModal" class="df-search-modal" aria-hidden="true">
            <button type="button" class="btn-close-search" id="btnCloseSearch" aria-label="Close Search">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="search-modal-content">
                <h3 class="search-modal-title">What are you craving today?</h3>
                <div class="search-input-wrap">
                    <input type="text" id="dfSearchInput" class="search-input" placeholder="Search delicacies, mocktails, chef's specials..." autocomplete="off" />
                    <button type="button" class="btn-search-submit" aria-label="Submit Search">
                        <i class="fa-solid fa-arrow-right-long"></i>
                    </button>
                </div>
                <div class="quick-tags mt-4">
                    <span class="tag-label">Popular:</span>
                    <a href='<%= ResolveUrl("~/Visitor/OurMenu.aspx") %>#punjabi-special' class="tag-pill">Paneer Tikka Angara</a>
                    <a href='<%= ResolveUrl("~/Visitor/OurMenu.aspx") %>#gujarati-special' class="tag-pill">Rajwadi Gujarati Thali</a>
                    <a href='<%= ResolveUrl("~/Visitor/OurMenu.aspx") %>#italian-special' class="tag-pill">Exotic Veg Cheese Burst Pizza</a>
                    <a href='<%= ResolveUrl("~/Visitor/OurMenu.aspx") %>#chinese-special' class="tag-pill">Spicy Veg Manchow Soup</a>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <main id="mainContainer" class='<%= IsOrderPage ? "main-content-wrap order-main-container" : "main-content-wrap" %>'>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>



        <!-- Global Master Footer -->
        <footer class="df-footer">
            <div class="footer-top">
                <div class="container container-xl">
                    <div class="row g-4 g-lg-5">
                        <div class="col-lg-3 col-md-6">
                            <div class="footer-col brand-col">
                                <a class="df-brand mb-3" href='<%= ResolveUrl("~/Visitor/Home.aspx") %>'>
                                    <span class="brand-crest"><i class="fa-solid fa-utensils"></i></span>
                                    <span class="brand-text">Dine<span>Flow</span></span>
                                </a>
                                <p class="brand-desc">
                                    Redefining high-end gastronomy through seamless luxury, interactive QR dining, and exceptional culinary art.
                                </p>
                                <div class="footer-socials">
                                    <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                                    <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                                    <a href="#" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
                                    <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-6 col-6">
                            <div class="footer-col">
                                <h4 class="footer-title">Quick Links</h4>
                                <ul class="footer-links">
                                    <li><a href='<%= ResolveUrl("~/Visitor/Home.aspx") %>'>Home</a></li>
                                    <li><a href='<%= ResolveUrl("~/Visitor/About.aspx") %>'>About Story</a></li>
                                    <li><a href='<%= ResolveUrl("~/Visitor/OurMenu.aspx") %>'>Our Menu</a></li>
                                    <li><a href='<%= ResolveUrl("~/Visitor/Gallery.aspx") %>'>Ambiance</a></li>
                                    <li><a href='<%= ResolveUrl("~/Visitor/Branches.aspx") %>'>Locations</a></li>
                                    <li><a href='<%= ResolveUrl("~/Visitor/Blog.aspx") %>'>Journal</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-6 col-6">
                            <div class="footer-col">
                                <h4 class="footer-title">Opening Hours</h4>
                                <ul class="footer-schedule">
                                    <li>
                                        <span class="day">Mon - Thu:</span>
                                        <span class="time">17:00 - 23:00</span>
                                    </li>
                                    <li>
                                        <span class="day">Fri - Sat:</span>
                                        <span class="time">16:30 - 00:30</span>
                                    </li>
                                    <li>
                                        <span class="day">Sun Special:</span>
                                        <span class="time">12:00 - 22:30</span>
                                    </li>
                                    <li class="status-indicator mt-2">
                                        <span class="status-dot green"></span> Live Service Available
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-6">
                            <div class="footer-col">
                                <h4 class="footer-title">Contact</h4>
                                <ul class="footer-contact">
                                    <li>
                                        <i class="fa-solid fa-location-dot"></i>
                                        <span>742 Fifth Avenue, Luxury District, NY 10019</span>
                                    </li>
                                    <li>
                                        <i class="fa-solid fa-phone"></i>
                                        <span>+1 (800) 555-DINE</span>
                                    </li>
                                    <li>
                                        <i class="fa-solid fa-envelope"></i>
                                        <span>concierge@dineflow.com</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="footer-col">
                                <h4 class="footer-title">Newsletter</h4>
                                <p class="footer-newsletter-text">Stay updated with our latest culinary offerings and private events.</p>
                                <div class="footer-newsletter-input">
                                    <input type="email" id="txtFooterEmail" placeholder="Your Email Address" class="form-control df-input-sm" />
                                    <button type="button" id="btnFooterSubscribe" class="btn-df-gold-sm"><i class="fa-solid fa-arrow-right"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="container container-xl">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                        <p class="copyright mb-0">
                            &copy; <%= DateTime.Now.Year %> DineFlow Ecosystem. All rights reserved.
                        </p>
                        <ul class="legal-links mb-0">
                            <li><a href='<%= ResolveUrl("~/Visitor/PrivacyPolicy.aspx") %>'>Privacy Policy</a></li>
                            <li><a href='<%= ResolveUrl("~/Visitor/TermsConditions.aspx") %>'>Terms of Service</a></li>
                            <li><a href='<%= ResolveUrl("~/Visitor/FAQ.aspx") %>'>Help & FAQs</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Back To Top Button -->
        <button type="button" id="btnBackToTop" class="btn-back-to-top" aria-label="Back to Top">
            <svg class="progress-circle" width="100%" height="100%" viewBox="-1 -1 102 102">
                <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" />
            </svg>
            <i class="fa-solid fa-arrow-up"></i>
        </button>

        <!-- Global Third-Party Libraries -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" integrity="sha512-7eHRwcbYkK4d9g/6tD/mhkf++WIBubgE/Vbf1_yVVzqDAnx8138wE4hUovLchFY538yu243L8WW6IkCqntO5Eg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" integrity="sha512-onMTRKJBKz8M1TnqqDuGBlowlH0ohFzMXYRNebz+yOcc5TMa3SgFbyOcxocN6lwCeLY+O4h5AXM5P5qndzuTWg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js" integrity="sha512-A7AYk1fGKX6S2rqRJ6zmIeI24NgiQfc1581kcEX+41Ffu61MVznPM144nsDpFi8UUKyxtEFTXvfA7yQ44vgVOg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

        <!-- Global Master Script -->
        <script src="<%= ResolveUrl("~/Assets/JS/master.js") %>"></script>

        <asp:ContentPlaceHolder ID="scripts" runat="server">
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>